{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C64: Build",
      "type": "shell",
      "command": "java -jar /Users/brianmorrice/dev/tools/kickassembler/KickAss.jar \"${workspaceFolder}/src/main.asm\" -odir \"${workspaceFolder}/build\" -o \"${workspaceFolder}/build/shooter.prg\" -vicesymbols && rm -f \"${workspaceFolder}/build/shooter.d64\" && /opt/homebrew/bin/c1541 -format \"19656,01\" d64 \"${workspaceFolder}/build/shooter.d64\" && /opt/homebrew/bin/c1541 \"${workspaceFolder}/build/shooter.d64\" -write \"${workspaceFolder}/build/shooter.prg\" 19656",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "C64: Run in VICE",
      "type": "shell",
      "command": "/opt/homebrew/bin/x64sc",
      "args": [
        "${workspaceFolder}/build/shooter.prg"
      ],
      "dependsOn": "C64: Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
